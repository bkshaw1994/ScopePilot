# ScopePilot Environment Variables
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Public Client Keys)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase (Server Admin Privileged Key - NEVER in browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Connection (Direct connection for migrations)
SUPABASE_DB_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# AI Provider Configuration (gemini or openai)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"

# Optional Fallback Provider
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Security & Rate Limiting
RATE_LIMIT_MAX_COMPARISONS_PER_HOUR="10"
NEXT_TELEMETRY_DISABLED="1"
